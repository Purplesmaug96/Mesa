# --- zlib ---
set(MESA_ZLIB_AUTO OFF)
if(MESA_OP_ZLIB STREQUAL "auto" OR MESA_OP_ZLIB STREQUAL "enabled")
  pkg_check_modules(PC_ZLIB IMPORTED_TARGET zlib)
  if(PC_ZLIB_FOUND)
    set(dep_zlib PkgConfig::PC_ZLIB)
    add_compile_definitions(-DHAVE_ZLIB)
    set(MESA_ZLIB_AUTO ON)
  elseif(MESA_OP_ZLIB STREQUAL "enabled")
    message(FATAL_ERROR "mesa: zlib not found")
  endif()
else()
  set(dep_zlib "")
endif()
set(with_compression OFF)
if(dep_zlib)
  set(with_compression ON)
endif()

