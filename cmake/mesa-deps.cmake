# --- LLVM ---
# Mesa uses llvm-config (config-tool method) on non-Windows; find_package(LLVM)
# is not used because LLVM's exports file is unreliable with multiple versions.
set(dep_llvm "")
set(llvm_with_orcjit ${MESA_OP_LLVM_ORCJIT})
set(with_clc OFF)
if(with_llvm STREQUAL "ON" OR with_llvm STREQUAL "AUTO")
  if(MESA_OP_SYSTEM_LLVM)
    find_program(LLVM_CONFIG_EXE llvm-config-22 llvm-config-21 llvm-config-20 llvm-config-19 llvm-config-18 llvm-config-17 llvm-config-16 llvm-config-15 llvm-config)
  endif()
  if(LLVM_CONFIG_EXE)
    execute_process(COMMAND ${LLVM_CONFIG_EXE} --version OUTPUT_VARIABLE LLVM_VERSION_STRING OUTPUT_STRIP_TRAILING_WHITESPACE)
    execute_process(COMMAND ${LLVM_CONFIG_EXE} --includedir OUTPUT_VARIABLE LLVM_INCLUDE_DIRS OUTPUT_STRIP_TRAILING_WHITESPACE)
    execute_process(COMMAND ${LLVM_CONFIG_EXE} --libdir OUTPUT_VARIABLE LLVM_LIBRARY_DIR OUTPUT_STRIP_TRAILING_WHITESPACE)
    execute_process(COMMAND ${LLVM_CONFIG_EXE} --shared-mode OUTPUT_VARIABLE LLVM_SHARED_MODE OUTPUT_STRIP_TRAILING_WHITESPACE)
    set(LLVM_FOUND TRUE)
  endif()
endif()
if(LLVM_FOUND)
  set(with_llvm ON)
  set(llvm_components
    core mcjit executionengine bitwriter engine mcdisassembler scalaropts
    transformutils instcombine native)
  if(host_cpu_family STREQUAL "x86_64" OR host_cpu_family STREQUAL "x86" OR host_cpu_family STREQUAL "aarch64")
    # MCJIT supported
  else()
    set(llvm_with_orcjit ON)
  endif()
  execute_process(
    COMMAND ${LLVM_CONFIG_EXE} --libs ${llvm_components}
    OUTPUT_VARIABLE LLVM_LIBS OUTPUT_STRIP_TRAILING_WHITESPACE)
  execute_process(
    COMMAND ${LLVM_CONFIG_EXE} --system-libs
    OUTPUT_VARIABLE LLVM_SYSTEM_LIBS OUTPUT_STRIP_TRAILING_WHITESPACE)
  set(LLVM_LIBS "${LLVM_LIBS} ${LLVM_SYSTEM_LIBS}")
  separate_arguments(LLVM_LIBS_LIST UNIX_COMMAND "${LLVM_LIBS}")
  # add definitions
  execute_process(COMMAND ${LLVM_CONFIG_EXE} --cppflags OUTPUT_VARIABLE LLVM_CPPFLAGS OUTPUT_STRIP_TRAILING_WHITESPACE)
  separate_arguments(LLVM_CPPFLAGS_LIST UNIX_COMMAND "${LLVM_CPPFLAGS}")
  foreach(_f IN LISTS LLVM_CPPFLAGS_LIST)
    if(_f MATCHES "^-D")
      string(SUBSTRING "${_f}" 2 -1 _def)
      add_compile_definitions(-D${_def})
    endif()
  endforeach()
  add_compile_definitions(
    -DMESA_LLVM_VERSION_STRING="${LLVM_VERSION_STRING}"
    -DLLVM_IS_SHARED=1
    -DGALLIVM_USE_ORCJIT=${llvm_with_orcjit})
  if(draw_with_llvm STREQUAL "AUTO")
    set(draw_with_llvm ON)
  endif()
  add_compile_definitions(-DDRAW_LLVM_AVAILABLE=1)
  message(STATUS "Mesa LLVM: ${LLVM_VERSION_STRING} at ${LLVM_LIBRARY_DIR}")
else()
  set(with_llvm OFF)
  set(draw_with_llvm OFF)
  set(amd_with_llvm OFF)
endif()
set(amd_with_llvm OFF)  # AMD LLVM path not enabled in this port

